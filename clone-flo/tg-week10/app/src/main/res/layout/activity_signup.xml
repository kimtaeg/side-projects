<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/signup_signup_tv"
        android:text="회원가입"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/signup_id_et"
        android:hint="아이디(이메일)"
        android:inputType="text"
        android:textSize="16sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:background="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_signup_tv"
        app:layout_constraintEnd_toStartOf="@id/signup_signup_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/signup_id_view"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:background="@color/black"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toStartOf="@id/signup_sign_tv"
        app:layout_constraintStart_toStartOf="@id/signup_id_et"
        app:layout_constraintTop_toBottomOf="@id/signup_id_et"/>

    <TextView
        android:id="@+id/signup_status_tv"
        android:textSize="14sp"
        android:textColor="@color/red"
        app:layout_constraintStart_toStartOf="@+id/signup_id_view"
        app:layout_constraintTop_toTopOf="@+id/signup_id_view"
        android:layout_marginTop="5dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/signup_sign_tv"
        android:text="\@"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@id/signup_id_et"
        app:layout_constraintTop_toTopOf="@id/signup_id_et"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/signup_input_et"
        android:hint="직접입력"
        android:textSize="16sp"
        android:inputType="textWebEmailAddress"
        android:background="@null"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/signup_sign_tv"
        app:layout_constraintTop_toTopOf="@id/signup_sign_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/signup_input_view"
        android:background="@color/black"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@+id/signup_input_et"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_input_et"
        android:layout_marginEnd="20dp"
        android:layout_width="0dp"
        android:layout_height="1px"/>

    <ImageView
        android:id="@+id/login_down_btn_iv"
        android:src="@drawable/nugu_btn_down"
        android:layout_width="25dp"
        android:layout_height="25dp"
        app:layout_constraintEnd_toEndOf="@id/signup_input_view"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@id/signup_input_view"/>

    <EditText
        android:id="@+id/signup_password_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:background="@null"
        android:hint="비밀번호"
        android:inputType="textPassword"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_id_view" />

    <View
        android:id="@+id/signup_password_view"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="@+id/signup_password_et"
        app:layout_constraintTop_toBottomOf="@+id/signup_password_et"
        app:layout_constraintEnd_toEndOf="@+id/signup_input_view"
        android:layout_marginTop="5dp"
        android:layout_width="0dp"
        android:layout_height="1px"/>

    <ImageView
        android:id="@+id/signup_password_iv"
        android:src="@drawable/btn_input_password"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="@+id/signup_password_view"
        app:layout_constraintBottom_toTopOf="@+id/signup_password_view"
        android:layout_width="30dp"
        android:layout_height="30dp"/>

    <EditText
        android:id="@+id/signup_password_check_et"
        android:hint="비밀번호 확인"
        android:background="@null"
        android:inputType="textPassword"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signup_password_view"
        android:layout_marginTop="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/signup_password_check_view"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="@+id/signup_password_check_et"
        app:layout_constraintTop_toBottomOf="@+id/signup_password_check_et"
        app:layout_constraintEnd_toEndOf="@+id/signup_input_view"
        android:layout_marginTop="5dp"
        android:layout_width="0dp"
        android:layout_height="1px"/>

    <ImageView
        android:id="@+id/signup_password_check_iv"
        android:src="@drawable/btn_input_password"
        app:layout_constraintEnd_toEndOf="@id/signup_password_check_view"
        app:layout_constraintBottom_toTopOf="@+id/signup_password_check_view"
        android:layout_marginEnd="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"/>

    <TextView
        android:id="@+id/signup_password_tv"
        android:textSize="12sp"
        android:textColor="@color/red"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/signup_password_check_view"
        app:layout_constraintTop_toBottomOf="@+id/signup_password_check_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/signup_nickname_et"
        android:background="@null"
        android:textSize="16sp"
        android:inputType="text"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@+id/signup_password_check_view"
        app:layout_constraintStart_toStartOf="@+id/signup_password_check_et"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="20dp"
        android:hint="닉네임"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/signup_nickname_view"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="@+id/signup_nickname_et"
        app:layout_constraintTop_toBottomOf="@+id/signup_nickname_et"
        app:layout_constraintEnd_toEndOf="@+id/signup_input_view"
        android:layout_marginTop="5dp"
        android:layout_width="0dp"
        android:layout_height="1px"/>

    <ImageView
        android:id="@+id/signup_nickname_iv"
        android:src="@drawable/btn_input_password"
        app:layout_constraintEnd_toEndOf="@id/signup_nickname_view"
        app:layout_constraintBottom_toTopOf="@+id/signup_nickname_view"
        android:layout_marginEnd="5dp"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
    
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/signup_signup_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="가입완료"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@color/blue"/>


    <ProgressBar
        android:id="@+id/sign_up_loading_pb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:indeterminateTint="@color/blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone"/>


</androidx.constraintlayout.widget.ConstraintLayout>