<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:orientation="vertical"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
                android:layout_height="wrap_content">

    <!--백그라운드 설정-->
                <LinearLayout
                    android:id="@+id/song_mix_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/textview_background_radius"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="5dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- 상단 MIX 토글 -->
                    <TextView
                        android:id="@+id/song_mix_tv"
                        android:layout_width="80dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="5dp"
                        android:text="내 취향 MIX"
                        android:textColor="@color/black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/song_mix_off_iv"
                        android:layout_width="50dp"
                        android:layout_height="30dp"
                        android:src="@drawable/btn_toggle_off"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="@id/song_mix_tv"
                        app:layout_constraintStart_toEndOf="@id/song_mix_tv"
                        app:layout_constraintTop_toTopOf="@id/song_mix_tv" />

                    <ImageView
                        android:id="@+id/song_mix_on_iv"
                        android:layout_width="50dp"
                        android:layout_height="30dp"
                        android:src="@drawable/btn_toggle_on"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/song_mix_tv"
                        app:layout_constraintStart_toEndOf="@id/song_mix_tv"
                        app:layout_constraintTop_toTopOf="@id/song_mix_tv" />

                </LinearLayout>

                <!-- 전체선택 -->
                <ImageView
                    android:id="@+id/song_select_iv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/btn_playlist_select_off"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/song_list_layout"
                    android:layout_marginBottom="5dp"
                    />

                <TextView
                    android:id="@+id/song_select_tv"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:text="전체선택"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toEndOf="@+id/song_select_iv"
                    app:layout_constraintTop_toTopOf="@+id/song_select_iv"
                    app:layout_constraintBottom_toBottomOf="@+id/song_select_iv"/>

                <!-- 전체듣기 -->
                <ImageView
                    android:id="@+id/song_listen_iv"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_browse_arrow_right"
                    app:layout_constraintEnd_toStartOf="@+id/song_listen_tv"
                    app:layout_constraintTop_toTopOf="@+id/song_listen_tv"
                    app:layout_constraintBottom_toBottomOf="@+id/song_listen_tv"/>

                <TextView
                    android:id="@+id/song_listen_tv"
                    android:layout_width="60dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:text="전체듣기"
                    android:textColor="@color/black"
                    android:layout_marginBottom="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/song_list_layout"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- 노래 리스트 -->
                <LinearLayout
                    android:id="@+id/song_list_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/song_mix_layout">


