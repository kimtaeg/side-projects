                            android:textSize="13dp"
                            android:textStyle="bold"
                            app:layout_constraintTop_toBottomOf="@+id/song_01_title"
                            app:layout_constraintStart_toStartOf="@+id/song_01_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <ImageView
