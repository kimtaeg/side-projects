<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/login_logo_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/ic_flo_logo"
        android:layout_marginTop="20dp"
        android:layout_width="85dp"
        android:layout_height="35dp"/>

    <EditText
        android:id="@+id/login_id_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="80dp"
        android:background="@null"
        android:hint="아이디(이메일)"
        android:inputType="text"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/login_logo_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_logo_iv" />

    <View
        android:id="@+id/login_id_view"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="5dp"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="@id/login_id_et"
        app:layout_constraintTop_toBottomOf="@id/login_id_et"
        app:layout_constraintEnd_toStartOf="@id/login_sign_tv"/>

    <TextView
        android:id="@id/login_sign_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="\@"
        app:layout_constraintBottom_toBottomOf="@+id/login_id_et"
        app:layout_constraintEnd_toEndOf="@+id/login_logo_iv"
        app:layout_constraintStart_toStartOf="@+id/login_logo_iv"
        app:layout_constraintTop_toTopOf="@+id/login_id_et" />

    <EditText
        android:id="@+id/login_input_et"
        android:hint="직접입력"
        android:inputType="textWebEmailAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@null"
        android:textSize="16sp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/login_sign_tv"
        app:layout_constraintTop_toTopOf="@id/login_id_et"/>

    <View
        android:id="@+id/login_input_view"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:background="@color/black"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/login_input_et"
        app:layout_constraintTop_toBottomOf="@id/login_input_et"/>

    <ImageView
        android:id="@+id/login_down_btn_iv"
        android:src="@drawable/nugu_btn_down"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="@id/login_input_et"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toTopOf="@id/login_input_view"/>

    <EditText
        android:id="@+id/login_password_et"
        android:hint="비밀번호"
        android:inputType="textPassword"
        android:background="@null"
        android:textSize="16sp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="@+id/login_id_view"
        app:layout_constraintTop_toBottomOf="@+id/login_id_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <View
        android:id="@+id/login_password_view"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="@+id/login_password_et"
        app:layout_constraintTop_toBottomOf="@+id/login_password_et"
        app:layout_constraintEnd_toEndOf="@+id/login_input_view"
        android:layout_marginTop="5dp"
        android:layout_width="0dp"
        android:layout_height="1px"/>
    
    <ImageView
        android:id="@+id/login_password_iv"
        android:src="@drawable/btn_input_password"
        app:layout_constraintEnd_toEndOf="@id/login_password_view"
        app:layout_constraintBottom_toTopOf="@id/login_password_view"
        android:layout_marginEnd="3dp"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
    
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/login_in_btn"
        android:background="@color/blue"
        android:text="로그인"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/login_password_view"
        app:layout_constraintStart_toStartOf="@+id/login_password_view"
        app:layout_constraintEnd_toEndOf="@+id/login_password_view"
        android:layout_marginTop="40dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/login_find_id_tv"
        app:layout_constraintStart_toStartOf="@id/login_in_btn"
        app:layout_constraintTop_toBottomOf="@id/login_in_btn"
        android:layout_marginTop="10dp"
        android:text="아이디 찾기"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/login_tv"
        android:text="|"
        app:layout_constraintStart_toEndOf="@id/login_find_id_tv"
        app:layout_constraintTop_toBottomOf="@id/login_in_btn"
        android:layout_marginTop="10dp"
        android:layout_marginStart="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/login_find_password_tv"
        android:text="비밀번호 찾기"
        app:layout_constraintStart_toEndOf="@id/login_tv"
        app:layout_constraintTop_toBottomOf="@id/login_in_btn"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/login_signup_tv"
        android:text="회원가입"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/login_in_btn"
        app:layout_constraintTop_toBottomOf="@id/login_in_btn"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/login_id_login_layout"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="35dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/login_signup_tv"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/black">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ico_20_logo_tid_white"/>
        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="아이디로 로그인"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_phone_number_login_layout"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/light_gray"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_id_login_layout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        tools:layout_editor_absoluteY="550dp">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/btn_setting_phone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="휴대폰 번호 로그인"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_phone_number_login_layout">

        <ImageView
            android:id="@+id/login_naver_login_iv"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/naver_44" />

        <ImageView
            android:id="@+id/login_kakako_login_iv"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/kakako_44" />

        <ImageView
            android:id="@+id/login_apple_login_iv"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/apple_44" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


