<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp"
    android:paddingVertical="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
    android:id="@+id/item_album_cover_img_cv"
    android:layout_width="70dp"
    android:layout_height="70dp"
    app:cardCornerRadius="7dp"
    app:cardElevation="0dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/item_save_cover_img_iv"
            android:src="@drawable/justin"
            android:layout_width="70dp"
            android:layout_height="70dp"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/save_title_tv"
        android:text="SPEED DEMON"
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@+id/item_album_cover_img_cv"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/save_name_tv"
        android:text="Justin bieber"
        android:textSize="15dp"
        app:layout_constraintTop_toBottomOf="@+id/save_title_tv"
        app:layout_constraintStart_toStartOf="@+id/save_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/save_more_iv"
        android:src="@drawable/btn_player_more"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"
        android:layout_width="50dp"
        android:layout_height="50dp"/>

    <ImageView
        android:id="@+id/save_play_iv"
        android:src="@drawable/btn_miniplayer_play"
        app:layout_constraintEnd_toStartOf="@+id/save_more_iv"
        app:layout_constraintTop_toTopOf="@+id/save_more_iv"
        android:layout_width="50dp"
        android:layout_height="50dp"/>

    <ImageView
        android:id="@+id/save_pause_iv"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toStartOf="@+id/save_more_iv"
        app:layout_constraintTop_toTopOf="@+id/save_more_iv"
        android:src="@drawable/btn_miniplay_mvpause"
        android:visibility="gone"
        />
</androidx.constraintlayout.widget.ConstraintLayout>