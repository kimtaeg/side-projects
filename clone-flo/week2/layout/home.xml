<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        
        <ImageView
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:src="@drawable/img_first_album_default"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/sitting"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/btn_main_setting"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="30dp"
            />

        <ImageView
            android:id="@+id/ticket"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/btn_main_ticket"
            app:layout_constraintEnd_toStartOf="@+id/sitting"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="10dp"
            />

        <ImageView
            android:id="@+id/mike"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/btn_main_mike"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ticket"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="10dp"
            />

        <ImageView
            android:id="@+id/play_large"
            android:src="@drawable/btn_panel_play_large"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:layout_constraintTop_toBottomOf="@+id/sitting"
            app:layout_constraintEnd_toEndOf="@+id/sitting"
            android:layout_marginTop="60dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/title"
            android:text="달밤의 감성 산책"
            android:textColor="@color/white"
            android:textSize="30dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mike"
            android:layout_marginStart="20dp"
            android:layout_marginTop="5dp"/>

        <ImageView
            android:id="@+id/album"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/img_album_exp"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/background"/>

        <ImageView
            android:id="@+id/album2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/img_album_exp"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="90dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/album"/>

        <TextView
            android:id="@+id/sing_name1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15dp"
            android:text="Lady"
            app:layout_constraintTop_toTopOf="@id/album2"
            app:layout_constraintStart_toEndOf="@id/album2"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/album_singer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:text="Kenshi Yonezu"
            app:layout_constraintStart_toEndOf="@id/album2"
            app:layout_constraintBottom_toBottomOf="@id/album2"
            app:layout_constraintTop_toBottomOf="@id/sing_name1"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/sing_name2"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="15dp"
            app:layout_constraintTop_toTopOf="@id/album"
            android:text="Spinning Globe"
            app:layout_constraintStart_toEndOf="@id/album"
            app:layout_constraintBottom_toTopOf="@id/album_singer2"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/album_singer2"
            android:text="Kenshi Yonezu"
            android:textColor="@color/white"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@id/album"
            app:layout_constraintBottom_toBottomOf="@id/album"
            app:layout_constraintTop_toBottomOf="@id/sing_name2"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="총 10곡 2025.03.30"
            android:textColor="@color/white"
            android:textSize="15dp"
            app:layout_constraintStart_toStartOf="@id/background"
            app:layout_constraintBottom_toTopOf="@id/album2"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 발매 음악"
            android:textSize="15dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/background"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"/>

        <ImageView
            android:id="@+id/today_arrow"
            android:src="@drawable/btn_main_arrow_more"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toEndOf="@id/today"
            app:layout_constraintBottom_toBottomOf="@id/today"/>

        <ImageView
            android:id="@+id/today_album"
            android:src="@drawable/img_album_exp"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintTop_toBottomOf="@+id/today"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/today_sing_name"
            android:text="Lost corner"
            android:textSize="20dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/today_album"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="10dp"/>

        <TextView
            android:text="Kenshi Yonezu"
            android:textSize="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/today_sing_name"
            android:layout_marginStart="10dp"
            android:textColor="@color/light_gray"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
