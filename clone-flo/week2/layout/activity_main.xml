<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.9" />

    <ImageView
        android:id="@+id/home_button"
        android:src="@drawable/ic_bottom_home_no_select"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:text="홈"
        android:textColor="@color/light_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/home_button" />

    <ImageView
        android:id="@+id/look_button"
        android:src="@drawable/ic_bottom_look_no_select"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/home_button"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="34dp"
        android:layout_marginStart="40dp"
        app:layout_constraintEnd_toStartOf="@id/search_button"/>

    <TextView
        android:id="@+id/look"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:text="둘러보기"
        android:textColor="@color/light_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/home"
        app:layout_constraintTop_toBottomOf="@+id/look_button"
        android:layout_marginBottom="5dp"
        app:layout_constraintEnd_toStartOf="@id/search"/>

    <ImageView
        android:id="@+id/search_button"
        android:src="@drawable/ic_bottom_search_no_select"
        app:layout_constraintStart_toEndOf="@+id/look_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="40dp"
        android:layout_width="31dp"
        android:layout_height="31dp"
        app:layout_constraintEnd_toStartOf="@id/locker_button"/>

    <TextView
        android:id="@+id/search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginBottom="5dp"
        android:text="검색"
        android:textColor="@color/light_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/look"
        app:layout_constraintTop_toBottomOf="@+id/search_button"
        app:layout_constraintEnd_toStartOf="@id/locker"/>

    <ImageView
        android:id="@+id/locker_button"
        android:src="@drawable/ic_bottom_locker_no_select"
        app:layout_constraintStart_toEndOf="@+id/search_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_horizontal"
        android:layout_marginBottom="38dp"
        android:layout_marginStart="40dp"
        android:layout_width="37dp"
        android:layout_height="37dp"/>

    <TextView
        android:id="@+id/locker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="5dp"
        android:text="보관함"
        android:textColor="@color/light_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/search"
        app:layout_constraintTop_toBottomOf="@+id/locker_button"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/list"
        android:src="@drawable/btn_miniplayer_go_list"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toTopOf="@id/guideline_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"/>

    <ImageView
        android:id="@+id/next_button"
        android:src="@drawable/btn_miniplayer_next"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toStartOf="@+id/list"
        app:layout_constraintBottom_toTopOf="@id/guideline_horizontal"/>

    <ImageView
        android:id="@+id/play_button"
        android:src="@drawable/btn_miniplayer_play"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toStartOf="@+id/next_button"
        app:layout_constraintBottom_toBottomOf="@id/guideline_horizontal"/>

    <ImageView
        android:id="@+id/previous_button"
        android:src="@drawable/btn_miniplayer_previous"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintBottom_toTopOf="@id/guideline_horizontal"/>

    <TextView
        android:id="@+id/miniplayer_sing_name"
        android:text="Pop Song"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline_horizontal"
        android:layout_width="wrap_content"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="20dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/miniplayer_singer_name"
        android:text="Kenshi Yonezu"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/miniplayer_sing_name"
        app:layout_constraintStart_toStartOf="parent"/>





</androidx.constraintlayout.widget.ConstraintLayout>