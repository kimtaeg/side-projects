<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_pannel_background_vp"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_first_album_default"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- 일단 의존성을 추가 시킨다, 그리고 circleindicator3를 사용하고
            homefragment에 가서         binding.homePannelIndicator.setViewPager(binding.homePannelBackgroundVp)
            로 Indicator에 viewPager 설정하면 짜잔?-->
            <me.relex.circleindicator.CircleIndicator3
                android:id="@+id/home_pannel_indicator"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                app:ci_drawable="@drawable/indicator_selected"
                app:ci_drawable_unselected="@drawable/indicator_unselected"
                app:ci_animator="@animator/scale_with_alpha"
                app:layout_constraintTop_toBottomOf="@id/home_pannel_background_vp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        <!--<ImageView
            android:id="@+id/home_background_iv"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_first_album_default"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />-->

        <ImageView
            android:id="@+id/home_btn_nugu_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/btn_main_mike"
            app:layout_constraintEnd_toStartOf="@id/home_btn_ticket_iv"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home_btn_ticket_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/btn_main_ticket"
            app:layout_constraintEnd_toStartOf="@id/home_btn_setting_iv"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/home_btn_setting_iv"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:src="@drawable/btn_main_setting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/home_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="15dp"
            android:text="코딩할때 듣기 좋은 노래"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/home_btn_nugu_iv" />

        <ImageView
            android:id="@+id/home_btn_play_iv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/btn_panel_play_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/home_title_tv" />

        <TextView
            android:id="@+id/home_pannel_album_info_01_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp"
            android:text="총 15곡 2019.11.11"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/home_album_img_01_iv"
            app:layout_constraintStart_toStartOf="parent" />


        <ImageView
            android:id="@+id/home_album_img_01_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/homideul"
            app:layout_constraintBottom_toTopOf="@id/home_album_img_02_iv"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/home_album_title_01_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="MUFFIN (feat. Beenzino)"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/home_album_singer_02_tv"
            app:layout_constraintStart_toEndOf="@id/home_album_img_01_iv"
            app:layout_constraintTop_toTopOf="@id/home_album_img_01_iv" />

        <TextView
            android:id="@+id/home_album_singer_02_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="호미들"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/home_album_img_01_iv"
            app:layout_constraintStart_toEndOf="@id/home_album_img_01_iv"
            app:layout_constraintTop_toBottomOf="@id/home_album_title_01_tv" />


        <ImageView
            android:id="@+id/home_album_img_02_iv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/kc"
            app:layout_constraintBottom_toBottomOf="@id/home_pannel_background_vp"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/home_album_title_03_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="LALALA (Snitch Club)"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/home_album_singer_04_tv"
            app:layout_constraintStart_toEndOf="@id/home_album_img_02_iv"
            app:layout_constraintTop_toTopOf="@id/home_album_img_02_iv" />

        <TextView
            android:id="@+id/home_album_singer_04_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="식케이, Lil Moshipt"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/home_album_img_02_iv"
            app:layout_constraintStart_toEndOf="@id/home_album_img_02_iv"
            app:layout_constraintTop_toBottomOf="@id/home_album_title_03_tv" />

        <TextView
            android:id="@+id/home_today_music_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="5dp"
            android:text="오늘 발매 음악"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/home_pannel_background_vp" />

        <ImageView
            android:id="@+id/home_today_music_title_btn_iv"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginEnd="5dp"
            android:scaleType="fitStart"
            android:src="@drawable/btn_main_arrow_more"
            app:layout_constraintBottom_toBottomOf="@id/home_today_music_title_tv"
            app:layout_constraintStart_toEndOf="@id/home_today_music_title_tv"
            app:layout_constraintTop_toTopOf="@id/home_today_music_title_tv" />

        <TextView
            android:id="@+id/home_today_total_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="종합"
            android:textColor="@color/blue"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/home_today_domestic_tv"
            app:layout_constraintTop_toBottomOf="@id/home_pannel_background_vp" />

        <TextView
            android:id="@+id/home_today_domestic_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="국내"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/home_today_oversea_tv"
            app:layout_constraintTop_toBottomOf="@id/home_pannel_background_vp" />

        <TextView
            android:id="@+id/home_today_oversea_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="해외"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/home_pannel_background_vp" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_today_music_album_rv"
            app:layout_constraintTop_toBottomOf="@+id/home_today_oversea_tv"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/home_banner_vp"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/home_today_music_album_rv"/>

        <!-- Indicator

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/homeBannerIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/white"
            app:tabSelectedTextColor="@color/white"
            app:tabIndicatorFullWidth="false"
            app:tabGravity="center"
            app:tabMode="fixed"
            app:layout_constraintTop_toBottomOf="@+id/home_pannel_background_vp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_potcast_rv"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            app:layout_constraintTop_toBottomOf="@+id/home_potcast_tv"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_potcast"
            />

        <TextView
            android:id="@+id/home_potcast_tv"
            android:text="매일 들어도 좋은 팟캐스트"
            android:textSize="30dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/home_banner_vp"
            android:layout_marginTop="10dp"/>



        <TextView
            android:id="@+id/home_video_tv"
            android:text="비디오 콜랙션"
            android:textSize="30dp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/home_potcast_rv"
            android:layout_marginTop="20dp"/>

        <ImageView
            android:id="@+id/home_video_iv"
            android:src="@drawable/img_video_exp"
            app:layout_constraintTop_toBottomOf="@id/home_video_tv"
            android:layout_width="320dp"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/home_video_title_tv"
            android:text="제목"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20dp"
            app:layout_constraintTop_toBottomOf="@id/home_video_iv"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/home_video_name_tv"
            android:text="가수"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/home_video_title_tv"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/home_video2_iv"
            android:src="@drawable/img_video_exp"
            app:layout_constraintTop_toBottomOf="@id/home_video_tv"
            app:layout_constraintStart_toEndOf="@+id/home_video_iv"
            android:layout_width="320dp"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp" />

        <TextView
            android:id="@+id/home_video_title2_tv"
            android:text="제목"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="20dp"
            app:layout_constraintTop_toBottomOf="@id/home_video2_iv"
            app:layout_constraintStart_toStartOf="@+id/home_video2_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/home_video_name_tv2"
            android:text="가수"
            android:textSize="20dp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/home_video_title2_tv"
            app:layout_constraintStart_toStartOf="@+id/home_video2_iv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:id="@+id/home_banner_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-370dp"
            android:src="@drawable/discovery_banner_aos"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/home_video_name_tv" />

        <ImageView
            android:id="@+id/home_main_ad_banner_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/img_home_viewpager_exp2"
            android:layout_marginTop="-450dp"
            app:layout_constraintTop_toBottomOf="@id/home_banner_iv"/>

        <ImageView
            android:id="@+id/home_main_social_banner_fb_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="-90dp"
            android:src="@drawable/ic_main_facebook"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="100dp"
            app:layout_constraintTop_toBottomOf="@id/home_main_ad_banner_iv"/>

        <ImageView
            android:id="@+id/home_main_social_banner_ig_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="-87dp"
            android:src="@drawable/ic_main_instagram"
            android:layout_marginLeft="30dp"
            app:layout_constraintStart_toEndOf="@id/home_main_social_banner_fb_iv"
            app:layout_constraintTop_toBottomOf="@id/home_main_ad_banner_iv"/>

        <ImageView
            android:id="@+id/home_main_social_banner_yt_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="-87dp"
            android:layout_marginLeft="30dp"
            android:src="@drawable/ic_main_youtube"
            app:layout_constraintStart_toEndOf="@id/home_main_social_banner_ig_iv"

            app:layout_constraintTop_toBottomOf="@id/home_main_ad_banner_iv"/>

        <ImageView
            android:id="@+id/home_main_social_banner_tt_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="-87dp"
            android:src="@drawable/ic_main_twitter"
            android:layout_marginLeft="30dp"
            app:layout_constraintStart_toEndOf="@id/home_main_social_banner_yt_iv"

            app:layout_constraintTop_toBottomOf="@id/home_main_ad_banner_iv"/>

        <TextView
            android:id="@+id/home_main_footer_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(주)드림어스컴퍼니 사업자 정보"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/home_main_social_banner_fb_iv"/>

        <ImageView
            android:id="@+id/btn_main_arrow_more_footer_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/btn_main_arrow_more"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/home_main_social_banner_fb_iv"
            app:layout_constraintStart_toEndOf="@id/home_main_footer_tv"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>